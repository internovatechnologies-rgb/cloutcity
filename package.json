{
  "name": "cloutcity",
  "version": "0.1.0",
  "private": true,
  "description": "Clout City: NYC. Tap In. Blow Up.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p src/sw/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "e2e": "playwright test",
    "e2e:supabase": "playwright test --config playwright.supabase.config.ts",
    "e2e:perf": "playwright test --config playwright.perf.config.ts",
    "e2e:dpl": "playwright test --config playwright.dpl.config.ts",
    "budget": "node scripts/budget.ts && node scripts/shell-guard.ts",
    "handles:sql": "node scripts/moderation/blocklist-sql.ts",
    "db:types": "supabase gen types --local --schema public > src/lib/supabase/database.types.ts",
    "geo:build": "node scripts/geo/build.ts",
    "audio:build": "node scripts/audio/build.ts",
    "assets:build": "node scripts/assets/build.ts",
    "blender:build": "node scripts/blender/build.ts",
    "econ:update": "vitest run src/engine/sim --update"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@serwist/window": "9.5.13",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "three": "0.182.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.63.0",
    "@serwist/turbopack": "9.5.13",
    "@tailwindcss/postcss": "4.3.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.182.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-server": "3.0.4",
    "@types/topojson-simplify": "3.0.3",
    "@types/topojson-specification": "1.0.5",
    "csv-parse": "7.0.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "fflate": "0.8.3",
    "meshoptimizer": "1.3.0",
    "postcss": "8.5.29",
    "postgres": "3.4.9",
    "prettier": "3.9.9",
    "serwist": "9.5.13",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.3",
    "topojson-client": "3.1.0",
    "topojson-server": "3.0.1",
    "topojson-simplify": "3.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
